# Vorlage fuer alle Umgebungsvariablen. Reale Werte gehoeren in .env
# (lokal) bzw. direkt in die Umgebungsvariablen-Einstellungen der
# Hosting-Plattform (Railway/Render) — niemals in dieses Repo committen.

# Postgres-Verbindung. In Railway: von der Postgres-Datenbank die
# "DATABASE_URL" (bzw. "DATABASE_PUBLIC_URL" fuer Zugriff von ausserhalb
# des Railway-Netzwerks, z. B. lokal) kopieren.
DATABASE_URL="postgresql://user:password@localhost:5432/einladi"

# Session/Token-Signierschluessel. Neu generieren pro Umgebung, niemals
# zwischen dev und production teilen: `openssl rand -base64 32`
AUTH_SECRET=""

# Echte, oeffentlich erreichbare Basis-URL dieser Umgebung. OHNE diesen
# Wert baut next-auth Anmelde-Links mit "localhost" statt der echten
# Domain — Login schlaegt dann in Produktion komplett fehl.
AUTH_URL="http://localhost:3000"

# Stripe. Test-Keys fuer dev/staging, Live-Keys erst nach Aktivierung
# des echten Stripe-Kontos fuer production.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Echte, oeffentlich erreichbare Domain dieser Umgebung (ohne
# abschliessenden Slash), z. B. https://einladi.de
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transaktions-E-Mail (Resend). Ohne diese zwei Werte werden Anmelde-
# Links nur in die Server-Konsole geloggt statt verschickt.
RESEND_API_KEY=""
EMAIL_FROM=""

# E-Mail-Adresse, an die neue Druckauftraege (QR-Karten drucken & per Post
# verschicken) benachrichtigt werden. Leer lassen = keine Benachrichtigung,
# der Auftrag landet trotzdem in der Datenbank (PrintOrder).
PRINT_ORDER_NOTIFY_EMAIL=""

# remove.bg API-Key fuer die "Hintergrund entfernen"-Funktion beim
# Titelbild (Dashboard). Ohne diesen Wert bleibt der Button ausgeblendet.
REMOVEBG_API_KEY=""

# OpenAI API-Key fuer die "KI-Design"-Funktion (Titelbild per Prompt
# anpassen, gpt-image-2). Ohne diesen Wert bleibt die Sektion ausgeblendet.
OPENAI_API_KEY=""

# Google Maps (Places-Autocomplete beim Event-Anlegen + Karten-Einbettung
# auf der oeffentlichen Event-Seite). Ohne diesen Wert bleiben Adressfeld
# und Karte einfache Text-Eingabe/-Anzeige ohne Google-Funktionen.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Datei-Speicher (Cloudflare R2). Ohne diese fuenf Werte wird lokales
# Dateisystem verwendet (nur fuer dev geeignet).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
