// Digital Event Studio — Datenmodell
// Prisma schema. Postgres (Railway-Managed-Datenbank in Produktion und
// lokal via dieselbe DATABASE_URL — SQLite diente nur als initialer
// Entwicklungsstand vor dem ersten echten Deploy).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Nutzer & Zugriff
// ---------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  // Optional — der Anmelde-Link per E-Mail bleibt der Standardweg, ein
  // Passwort ist eine zusaetzliche, vom Kunden selbst im Konto aktivierte
  // Option fuer schnelleren Login. "salt:hash" (crypto.scrypt, siehe
  // src/lib/password.ts) — kein neues npm-Paket noetig.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events        Event[]
  orders        Order[]
  subscriptions Subscription[]
  notifications Notification[]
  partner       Partner?       @relation(fields: [partnerId], references: [id])
  partnerId     String?
  accounts      Account[]
  sessions      Session[]
}

// -- Auth.js (next-auth) Adapter-Modelle --------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------
// Eventtypen — datengetrieben, damit neue Typen ohne Code-Aenderung
// hinzugefuegt werden koennen (Admin-Dashboard, spaeter).
// ---------------------------------------------------------------------

model EventType {
  id        String  @id @default(cuid())
  key       String  @unique // z.B. "hochzeit", "geburtstag-30"
  name      String
  category  String // z.B. "Hochzeit & Liebe", "Geburtstag", "Business"
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  events        Event[]
  templateLinks TemplateEventType[]
}

// ---------------------------------------------------------------------
// Templates — Design-Vorlagen. Farben/Fonts/Layout als Metadaten in der
// DB; die eigentliche visuelle Komponente lebt im Code (layoutKey
// referenziert die React-Komponente). Auswahl, Preis, Kategorie und
// Eventtyp-Zuordnung sind vollstaendig datengetrieben.
// ---------------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Template {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  name                 String
  category             String // z.B. "Zeitlos", "Botanisch", "Business"
  description          String?
  previewUrl           String?
  // Bild-Sequenz fuer die Umschlag-Reveal-Animation (EnvelopeReveal-
  // Komponente) — JSON-Array von Bild-URLs in Abspiel-Reihenfolge, z.B.
  // ["envelope-closed.png", ..., "card-final.png"]. Optional, da nicht
  // jedes Template diese Optik nutzt.
  envelopeSequenceUrls String?
  colors               String // JSON-String: {"primary":"#...", "accent":"#..."}
  fonts                String // JSON-String: {"display":"...", "body":"..."}
  layoutKey            String // referenziert die React-Template-Komponente
  priceCents           Int            @default(0)
  status               TemplateStatus @default(DRAFT)
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events         Event[]
  eventTypeLinks TemplateEventType[]
  moduleDefaults TemplateModule[]
}

// leere Zuordnung = Template fuer alle Eventtypen verfuegbar
model TemplateEventType {
  templateId  String
  eventTypeId String

  template  Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@id([templateId, eventTypeId])
}

// ---------------------------------------------------------------------
// Modul-Katalog — jedes Feature (Countdown, RSVP, Sitzplan, ...) ist ein
// Katalogeintrag. Neue Module-TYPEN brauchen weiterhin Code (die
// eigentliche UI), aber welche Module ein Template standardmaessig
// anbietet und welche pro Event an/aus sind, ist vollstaendig
// datengetrieben (siehe EventModule).
// ---------------------------------------------------------------------

model Module {
  id          String  @id @default(cuid())
  key         String  @unique // z.B. "countdown", "rsvp", "seating"
  name        String
  description String?
  category    String // z.B. "Basis", "Gaeste", "Premium"
  isPremium   Boolean @default(false)
  sortOrder   Int     @default(0)

  templateDefaults TemplateModule[]
  eventModules     EventModule[]
}

model TemplateModule {
  templateId       String
  moduleId         String
  enabledByDefault Boolean @default(true)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([templateId, moduleId])
}

// ---------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Event {
  id              String      @id @default(cuid())
  slug            String      @unique // .../e/<slug>
  title           String // z.B. "Anna & Lukas"
  subtitle        String?
  description     String?
  // Ueberschreibt das Standard-Anlass-Label (sonst EventType.name, z.B.
  // "Hochzeit") mit freiem Text, z.B. "DÜĞÜN DAVETİYESİ" — leer = Standard.
  eventLabel      String?
  // Zwei-Familien-Textblock (tuerkische Hochzeitskarten-Konvention,
  // "AİLESİ"), nur sichtbar wenn mindestens eines gesetzt ist — siehe
  // /e/[slug]/page.tsx. Bislang nur in der kostenlosen Design-Studio-
  // Vorschau (localStorage-Entwurf) moeglich, hier jetzt echt speicherbar.
  familyLeft      String?
  familyRight     String?
  eventDate       DateTime
  eventTime       String?
  locationName    String?
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  coverImageId    String?
  // Optionales Video statt der Standard-Umschlag-Animation — beim Antippen
  // spielt das Video, danach erscheint die eigentliche Einladung.
  envelopeVideoId String?
  // Optionaler Hintergrundmusik-Titel — kein Autoplay (Browser-Policy +
  // respektiert die Gaeste), stattdessen ein Schalter auf der Seite.
  backgroundMusicId String?
  colorOverride   String? // JSON-String, ueberschreibt Template.colors wenn gesetzt
  // JSON-String, z.B. {"fontId":"playfair","ornaments":true} — echte
  // Editor-Einstellungen fuer die oeffentliche Event-Seite (Schriftart,
  // Eck-Ornamente), analog zu colorOverride. null = Template-Standard.
  styleJson       String?
  // Steuert NUR die Saal-Live-Wand (/live/[eventId]), nicht die normale
  // Gaeste-Galerie auf dem Handy: "immediate" zeigt frisch freigegebene
  // Fotos sofort auf der grossen Leinwand, "next-morning" haelt sie dort
  // zurueck bis zum Morgen nach dem Event (siehe src/lib/live-wall.ts).
  liveWallMode    String      @default("immediate")
  viewCount       Int         @default(0)
  status          EventStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])
  eventTypeId String
  template    Template  @relation(fields: [templateId], references: [id])
  templateId  String
  coverImage  Media?    @relation("EventCoverImage", fields: [coverImageId], references: [id])
  envelopeVideo   Media? @relation("EventEnvelopeVideo", fields: [envelopeVideoId], references: [id])
  backgroundMusic Media? @relation("EventBackgroundMusic", fields: [backgroundMusicId], references: [id])
  order       Order?

  modules           EventModule[]
  guests            Guest[]
  tables            Table[]
  guestbookEntries  GuestbookEntry[]
  galleryItems      GalleryItem[]
  menuItems         MenuItem[]
  wishlistItems     WishlistItem[]
  musicRequests     MusicRequest[]
  qrCodes           QRCode[]
  printOrders       PrintOrder[]
  checkIns          CheckIn[]
  media             Media[]            @relation("EventMedia")
  addOns            EventAddOn[]
  aiDesignAttempts  AiDesignAttempt[]
  aiTextAttempts    AiTextAttempt[]
  seatingSuggestion SeatingSuggestion?
  viewDays          EventViewDay[]
  einladiKiMessages EinladiKiMessage[]
}

// Chat-Verlauf mit "Einladi KI" (Dashboard-Assistent) — pro Event, damit
// der Assistent beim naechsten Besuch weiss, worueber schon gesprochen
// wurde, und die Nachrichtenzahl gleichzeitig als Kontingent-Zaehler dient.
model EinladiKiMessage {
  id             String   @id @default(cuid())
  eventId        String
  role           String // "user" | "assistant"
  content        String
  suggestionJson String? // strukturierter Vorschlag (siehe einladi-ki.ts), falls vorhanden
  createdAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

// Taegliche Aufrufe-Zaehler fuer den Trend-Chart im Dashboard — separat vom
// laufenden Event.viewCount (bleibt die einfache Gesamtsumme), damit nicht
// eine Zeile pro Aufruf entsteht, sondern hoechstens eine pro Event und Tag.
model EventViewDay {
  id      String   @id @default(cuid())
  eventId String
  date    DateTime // auf Tagesbeginn (UTC) normalisiert
  count   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
}

// pro Event an/aus geschaltete Module inkl. optionaler Konfiguration
model EventModule {
  id       String  @id @default(cuid())
  eventId  String
  moduleId String
  enabled  Boolean @default(true)
  config   String? // JSON-String fuer modul-spezifische Einstellungen

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([eventId, moduleId])
}

// ---------------------------------------------------------------------
// Gaeste, RSVP, Sitzplan
// ---------------------------------------------------------------------

enum RsvpStatus {
  PENDING
  YES
  NO
}

model Guest {
  id           String   @id @default(cuid())
  eventId      String
  firstName    String
  lastName     String?
  email        String?
  phone        String?
  groupLabel   String? // z.B. Haushalt/Familie fuer gruppierte Einladungen
  invitedCount Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Personalisierter Einladungslink (/e/[slug]?g=<inviteToken>) — eigenes
  // Token statt der Guest-id, damit es sich unabhaengig von der internen
  // id neu vergeben liesse und in der URL nicht wie eine DB-id aussieht.
  inviteToken   String    @unique @default(cuid())
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp      RSVP?
  seat      Seat?
  checkIn   CheckIn?
  photoTags PhotoTag[]
}

model RSVP {
  id              String     @id @default(cuid())
  guestId         String     @unique
  status          RsvpStatus @default(PENDING)
  attendingCount  Int?
  childrenCount   Int?
  menuChoice      String?
  specialRequests String?
  message         String?
  respondedAt     DateTime?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Table {
  id       String @id @default(cuid())
  eventId  String
  name     String // z.B. "Tisch 1"
  capacity Int    @default(8)
  posX     Float?
  posY     Float?

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats       Seat[]
  media       Media[]
  printOrders PrintOrder[]
}

model Seat {
  id         String  @id @default(cuid())
  tableId    String
  guestId    String? @unique
  seatNumber Int

  table Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id])

  @@unique([tableId, seatNumber])
}

// Haelt genau einen (den zuletzt generierten) KI-Sitzplan-Vorschlag pro
// Event vor, bis er uebernommen oder verworfen wird — dataJson enthaelt
// bereits serverseitig validierte { tableId, guestIds[] }[]-Zuordnungen.
// Bei applySeatingSuggestion() wird trotzdem erneut gegen den aktuellen
// DB-Stand geprueft (Kapazitaet/Zuordnung koennte sich zwischenzeitlich
// geaendert haben).
model SeatingSuggestion {
  id        String   @id @default(cuid())
  eventId   String   @unique
  dataJson  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// Gaestebuch, Galerie, Medien (Foto/Video/Audio)
// ---------------------------------------------------------------------

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// zentrale Ablage fuer alle hochgeladenen Dateien (Datenschutz/Groesse/
// Status an einer Stelle steuerbar statt verstreut).
model Media {
  id              String           @id @default(cuid())
  eventId         String?
  // Gesetzt, wenn der Upload ueber einen Tisch-spezifischen QR-Code kam
  // (siehe /dashboard/events/[id]/qr/table/[tableId]) — ermoeglicht spaeter
  // "Fotos von Tisch X"-Filter, unabhaengig vom Sitzplan-Feature selbst.
  tableId         String?
  type            MediaType
  url             String
  thumbnailUrl    String?
  mimeType        String
  sizeBytes       Int
  uploaderName    String?
  status          ModerationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  // Von analyzeGalleryPhotos() gesetzt (KI-Foto-Kuration) — "empfehlung" |
  // "unscharf" | "duplikat" | "ok", plus kurze Begruendung. Bleibt null,
  // bis der Betreiber die Analyse aktiv anstoesst (kein Auto-Scan bei
  // jedem Upload, aus Kostengruenden).
  aiVerdict       String?
  aiVerdictReason String?

  event            Event?           @relation("EventMedia", fields: [eventId], references: [id], onDelete: Cascade)
  table            Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  eventCoverFor    Event[]          @relation("EventCoverImage")
  eventEnvelopeFor Event[]          @relation("EventEnvelopeVideo")
  eventMusicFor    Event[]          @relation("EventBackgroundMusic")
  guestbookEntries GuestbookEntry[]
  galleryItem      GalleryItem?
  photoTags        PhotoTag[]
}

model GuestbookEntry {
  id                String           @id @default(cuid())
  eventId           String
  authorName        String
  message           String?
  // Bei Einreichung per KI erkannte Sprache der Nachricht (z.B. "tr", "ku",
  // "de") und, falls nicht bereits Deutsch, eine KI-Uebersetzung ins
  // Deutsche — beides best-effort, bleibt bei Fehlern/ohne konfigurierten
  // Key einfach null, blockiert die Einreichung nie.
  detectedLanguage  String?
  translatedMessage String?
  mediaId           String?
  status            ModerationStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  // Von analyzeGuestbookEntries() gesetzt (KI-Gaestebuch-Kuration) —
  // "unangemessen" | "herzlich" | "ok", plus kurze Begruendung. Bleibt null,
  // bis der Betreiber die Analyse aktiv anstoesst (gleiches Muster wie
  // Media.aiVerdict bei der Foto-Kuration).
  aiVerdict         String?
  aiVerdictReason   String?

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id])
}

model GalleryItem {
  id        String           @id @default(cuid())
  eventId   String
  mediaId   String           @unique
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// Verknuepft Media (n) mit Guest (n) — wer auf welchem Foto/Video markiert
// ist. Haengt bewusst an Media statt an GalleryItem/GuestbookEntry: Media
// ist die zentrale Ablage, GalleryItem und GuestbookEntry haengen beide
// 1:1 daran, daher gilt ein Tag automatisch fuer beide Oberflaechen.
model PhotoTag {
  id        String   @id @default(cuid())
  mediaId   String
  guestId   String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([mediaId, guestId])
}

// ---------------------------------------------------------------------
// Menue, Wunschliste, Musikwuensche
// ---------------------------------------------------------------------

enum MenuCourse {
  STARTER
  MAIN
  DESSERT
  DRINK
}

model MenuItem {
  id          String     @id @default(cuid())
  eventId     String
  course      MenuCourse
  name        String
  description String?
  sortOrder   Int        @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum WishlistType {
  GIFT
  CASH
  HONEYMOON
  EXTERNAL
}

model WishlistItem {
  id          String       @id @default(cuid())
  eventId     String
  type        WishlistType
  title       String
  description String?
  url         String?
  sortOrder   Int          @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model MusicRequest {
  id        String   @id @default(cuid())
  eventId   String
  guestName String
  song      String
  artist    String
  message   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// QR-Codes, Check-in
// ---------------------------------------------------------------------

enum QRCodeType {
  EVENT_PAGE
  RSVP
  SEATING
  MENU
  GUESTBOOK
  MUSIC_REQUEST
  GALLERY_UPLOAD
  CHECK_IN
}

model QRCode {
  id        String     @id @default(cuid())
  eventId   String
  type      QRCodeType
  targetUrl String
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, type])
}

enum PrintSize {
  A6
  A5
  A4
}

enum QrTheme {
  CLASSIC
  MODERN_BLOCK
  GOLD_FRAME
}

enum PrintOrderStatus {
  PENDING
  PAID
  PRINTING
  SHIPPED
  CANCELLED
}

// Physischer Druck-&-Versand-Auftrag fuer eine QR-Design-Karte (Tisch-QR
// oder allgemeiner Event-QR) — komplett eigenstaendig, nicht ueber das
// bestehende Order-Modell abgewickelt (gleiche Begruendung wie bei
// EventAddOn: Order/Event sind 1:1 verknuepft, ein zweites, paralleles
// Bezahl-Modell vermeidet das Risiko, diese Eindeutigkeit aufzuweichen).
model PrintOrder {
  id                    String           @id @default(cuid())
  eventId               String
  tableId               String? // gesetzt, wenn es ein Tisch-QR ist; leer = allgemeiner Event-QR
  size                  PrintSize
  theme                 QrTheme          @default(CLASSIC)
  quantity              Int              @default(1)
  priceCents            Int
  shippingName          String
  shippingStreet        String
  shippingZip           String
  shippingCity          String
  shippingCountry       String           @default("DE")
  status                PrintOrderStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime         @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)
}

model CheckIn {
  id          String   @id @default(cuid())
  eventId     String
  guestId     String   @unique
  checkedInAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// Partner / White Label
// ---------------------------------------------------------------------

enum PartnerType {
  LOCATION
  DJ
  PHOTOGRAPHER
  VIDEOGRAPHER
  PLANNER
  CATERER
  AGENCY
}

model Partner {
  id             String      @id @default(cuid())
  slug           String      @unique // .../partner/<slug>
  name           String
  type           PartnerType
  contactEmail   String?
  brandColor     String?
  brandLogoUrl   String?
  commissionRate Float? // z.B. 0.1 = 10%
  createdAt      DateTime    @default(now())

  users  User[]
  orders Order[]
}

// ---------------------------------------------------------------------
// Pakete, Bestellungen, Zahlungen
// ---------------------------------------------------------------------

enum BillingType {
  ONE_TIME
  SUBSCRIPTION
}

model Package {
  id          String      @id @default(cuid())
  key         String      @unique // BASIC | PREMIUM | PREMIUM_PLUS | VIP | BUSINESS
  name        String
  description String?
  priceCents  Int
  billingType BillingType @default(ONE_TIME)
  features    String // JSON-String: Liste freigeschalteter Module/Limits
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)

  orders        Order[]
  subscriptions Subscription[]
}

// Eigenstaendig kaufbare Zusatzprodukte, losgeloest von den Einladungs-
// Paketen oben (z.B. "Foto & Video-Sammlung") — ein Event kann eins oder
// mehrere davon zusaetzlich zu seinem Package kaufen, unabhaengig davon,
// welches Package es hat. Bewusst NICHT ueber das bestehende Order-Modell
// abgewickelt: Order/Event sind aktuell 1:1 verknuepft und das wird an
// mehreren Stellen (Checkout, Stripe-Webhook, Billing-Seite) vorausgesetzt
// — ein eigenes, paralleles Bezahl-Modell vermeidet das Risiko, diese
// bestehenden Ablaeufe beim Aufweichen der 1:1-Beziehung zu brechen.
model AddOn {
  id          String      @id @default(cuid())
  key         String      @unique // z.B. "photo-video-collection"
  name        String
  description String?
  priceCents  Int
  billingType BillingType @default(ONE_TIME)
  moduleKeys  String // JSON-Array von Module.key, die dieses Add-on freischaltet, z.B. ["gallery"]
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)

  eventAddOns EventAddOn[]
}

model EventAddOn {
  id                    String      @id @default(cuid())
  eventId               String
  addOnId               String
  amountCents           Int
  currency              String      @default("EUR")
  status                OrderStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addOn AddOn @relation(fields: [addOnId], references: [id])

  @@unique([eventId, addOnId])
}

// Protokolliert jeden KI-Design-Versuch (Titelbild per Prompt anpassen,
// AddOn "ai-design") — sowohl zur Kontingent-Zaehlung (Anzahl Zeilen pro
// Event = verbrauchte Versuche) als auch zur Kostenkontrolle/Audit, da
// jeder Versuch echte OpenAI-Kosten verursacht.
model AiDesignAttempt {
  id        String   @id @default(cuid())
  eventId   String
  prompt    String
  resultUrl String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Ein Versuch mit dem Text-Assistenten (Einladungstext-Generator) —
// dataJson haelt die generierten { welcomeText, description }, damit die
// Seite nach dem Redirect den zuletzt generierten Vorschlag erneut
// anzeigen kann, ohne ihn ueber die URL mitzufuehren. Zaehlt zugleich als
// Kontingent (AI_TEXT_ATTEMPT_QUOTA), analog zu AiDesignAttempt.
model AiTextAttempt {
  id          String   @id @default(cuid())
  eventId     String
  prompt      String
  welcomeText String
  description String
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  packageId             String
  partnerId             String?
  eventId               String?     @unique
  amountCents           Int
  currency              String      @default("EUR")
  status                OrderStatus @default(PENDING)
  stripePaymentIntentId String?
  discountCode          String?
  createdAt             DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id])
  package  Package   @relation(fields: [packageId], references: [id])
  partner  Partner?  @relation(fields: [partnerId], references: [id])
  event    Event?    @relation(fields: [eventId], references: [id])
  payments Payment[]
}

enum DiscountType {
  PERCENT
  FIXED
}

// Katalog gueltiger Rabattcodes — Order.discountCode speichert nur den
// angewandten Code-String, die eigentliche Gueltigkeits-/Nutzungspruefung
// laeuft ueber diese Tabelle (Lookup per code in startCheckout()).
model DiscountCode {
  id        String       @id @default(cuid())
  code      String       @unique // normalisiert: Grossbuchstaben, getrimmt
  type      DiscountType
  value     Int // PERCENT: 0-100, FIXED: Cent-Betrag
  maxUses   Int? // null = unbegrenzt
  usedCount Int          @default(0)
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  packageId            String
  status               String    @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  startedAt            DateTime  @default(now())
  endsAt               DateTime?
  stripeSubscriptionId String?

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String
  amountCents     Int
  currency        String    @default("EUR")
  status          String // PENDING | SUCCEEDED | FAILED | REFUNDED
  stripePaymentId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// Benachrichtigungen
// ---------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
